<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows10.0.17763.0 (rather than plain net10.0-windows) unlocks the WinRT
         projections: Windows.Media.Ocr (FindText), Windows.Graphics.Imaging and
         Windows.Storage.Streams (Bitmap -> SoftwareBitmap), and later Windows.Graphics.Capture.
         17763 matches packaging\AppxManifest.xml's MinVersion exactly. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>AutoClicker.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>Auto Clicker</AssemblyTitle>
    <!-- Single source of truth for the version. packaging\Build-Package.ps1 reads this and
         injects "major.minor.patch.0" into packaging\AppxManifest.xml (MSIX needs 4 parts),
         so the manifest no longer has to be kept in step by hand. This is also what the CLI
         version flag reports. -->
    <Version>2.0.0</Version>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; SDK-style projects glob every **/*.cs
         beneath them, so it must be excluded from THIS project's compile set. -->
    <Compile Remove="AutoClicker.Tests\**" />
    <None Remove="AutoClicker.Tests\**" />
    <!-- Same reason: AutoClicker.Core lives in a subfolder but is its own project. Without
         this the exe would compile the engine sources a second time (duplicate types). -->
    <Compile Remove="AutoClicker.Core\**" />
    <None Remove="AutoClicker.Core\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI-free engine (sequence model, runner, input/vision backends, stores, CLI,
         MCP plumbing). Its types stay internal and are visible to this exe via the
         InternalsVisibleTo that now lives in AutoClicker.Core.csproj. -->
    <ProjectReference Include="AutoClicker.Core\AutoClicker.Core.csproj" />
  </ItemGroup>

</Project>