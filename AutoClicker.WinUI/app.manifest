<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity name="AutoClicker.WinUI.app" version="1.0.0.0" type="win32" />

  <!-- Windows 10 / 11. The GUID is the Windows 10+ supportedOS marker; this is what tells
       the OS the app is Win10-aware (and therefore eligible for PerMonitorV2 DPI). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Pre-Windows-10 fallback ("true/pm" = per-monitor v1) kept for parity with a
           classic desktop manifest; dpiAwareness below wins on Windows 10 1703+. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <!-- PerMonitorV2: the 150%-scaled 4K monitor needs this, and it is also what
           Microsoft.WinUI.props injects by default (DefaultDpiAwareSettings=PerMonV2). -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
