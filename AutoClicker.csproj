<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>AutoClicker.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>Auto Clicker</AssemblyTitle>
    <!-- Keep in step with Version in packaging\AppxManifest.xml (which needs 4 parts).
         This is what the CLI version flag reports. -->
    <Version>1.1.0</Version>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; SDK-style projects glob every **/*.cs
         beneath them, so it must be excluded from THIS project's compile set. -->
    <Compile Remove="AutoClicker.Tests\**" />
    <None Remove="AutoClicker.Tests\**" />
    <!-- The engine (SequenceRunner, InputSender, ProfileStore, SequenceFile...) is internal
         by design: only the UI and CLI are "public". Tests exercise that engine directly. -->
    <InternalsVisibleTo Include="AutoClicker.Tests" />
  </ItemGroup>

</Project>